{
  "manifest": {
    "discovery_commit": "19dc02c",
    "methodology_version": "1.0.0",
    "primary_feature": "z_gross_premium_20d",
    "frozen_before_new_data_pulled_at": "2026-09-23T00:00:00",
    "definition": {
      "source_column": "gross_premium",
      "source_column_origin": "reports/options-flow-research-dataset.parquet (daily aggregate, from api/services/options_flow_metrics.py::flow_totals()['premium']['gross'])",
      "formula": "z_gross_premium_20d(T, ticker) = (gross_premium(T) - rolling_mean(prior_20)) / rolling_std(prior_20)",
      "rolling_window_length_sessions": 20,
      "minimum_prior_observations_required": 10,
      "current_date_T_excluded_from_baseline": true,
      "exclusion_mechanism": "pandas .shift(1) applied to the per-ticker series BEFORE the .rolling(20, min_periods=10) call, so the window used for date T's mean/std spans dates strictly before T (never including T)",
      "standard_deviation_convention": "pandas .rolling().std() default: sample standard deviation, ddof=1",
      "grouping": "per-ticker (each ETF is z-scored against only its OWN trailing history, never pooled across ETFs)",
      "null_handling": "z is NaN whenever fewer than 10 prior observations exist (first ~10 sessions per ticker) or when rolling_std is exactly 0 (constant prior window); NaN/inf values are never zero-filled or imputed",
      "winsorization": "none applied anywhere in the frozen definition",
      "exact_source_code": [
        "def _zscore(col: str) -> pd.Series:",
        "    prior = g[col].shift(1)",
        "    roll_mean = prior.groupby(df[\"ticker\"]).rolling(Z_WINDOW, min_periods=Z_MIN_PERIODS).mean()",
        "    roll_std = prior.groupby(df[\"ticker\"]).rolling(Z_WINDOW, min_periods=Z_MIN_PERIODS).std()",
        "    roll_mean.index = roll_mean.index.droplevel(0)",
        "    roll_std.index = roll_std.index.droplevel(0)",
        "    z = (df[col] - roll_mean) / roll_std",
        "    return z.replace([np.inf, -np.inf], np.nan)",
        "",
        "df[\"z_gross_premium_20d\"] = _zscore(\"gross_premium\")"
      ],
      "constants_from_commit_19dc02c": {
        "Z_WINDOW": 20,
        "Z_MIN_PERIODS": 10
      },
      "verbatim_copy_note": "This is a byte-for-byte copy of _zscore()/Z_WINDOW/Z_MIN_PERIODS from scripts/run_options_flow_signal_design_v2.py at commit 19dc02c. v3's implementation must call this exact logic, not a reinterpretation."
    },
