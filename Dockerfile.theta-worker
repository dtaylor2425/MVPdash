# Legacy Railway path, now a Yahoo stock research worker (no Theta SDK).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements-stock-worker.txt .
RUN pip install -r requirements-stock-worker.txt
COPY api/__init__.py api/db.py api/
COPY api/services/ api/services/
COPY sql/ sql/
COPY jobs/ jobs/
CMD ["python", "jobs/market_data_refresh.py"]
